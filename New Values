  </p-table>

  <ng-template pTemplate="footer">
    <button pButton label="Cancel" (click)="onCancel()"></button>
    <button pButton label="Archive"></button>
    <button pButton label="Copy" class="p-button-success" (click)="onCopy()"></button>
  </ng-template>

</p-dialog>



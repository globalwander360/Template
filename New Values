🧩 4. SECOND DIALOG (TABLE SCREEN 🔥)

✅ TS

import { Component, Input, Output, EventEmitter, OnChanges } from '@angular/core';

@Component({
  selector: 'app-copy-confirm-dialog',
  templateUrl: './copy-confirm-dialog.component.html'
})
export class CopyConfirmDialogComponent implements OnChanges {

  @Input() visible = false;
  @Output() visibleChange = new EventEmitter<boolean>();

  @Input() fields: string[] = [];
  @Input() count = 0;

  tableData: any[] = [];

  ngOnChanges() {
    if (this.fields.length && this.count) {
      this.generateTable();
    }
  }

  generateTable() {
    this.tableData = [];

    for (let i = 0; i < this.count; i++) {
      let row: any = {};
      this.fields.forEach(f => row[f] = '');
      this.tableData.push(row);
    }
  }

  onCancel() {
    this.visible = false;
    this.visibleChange.emit(false);
  }

  onCopy() {
    console.log("FINAL DATA:", this.tableData);
    this.onCancel();
  }
}



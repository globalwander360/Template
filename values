✅ TS (copy-template-dialog.component.ts)

import { Component, EventEmitter, Input, Output } from '@angular/core';
import { FormBuilder, FormGroup } from '@angular/forms';

@Component({
  selector: 'app-copy-template-dialog',
  templateUrl: './copy-template-dialog.component.html',
  styleUrls: ['./copy-template-dialog.component.scss']
})
export class CopyTemplateDialogComponent {

  @Input() visible: boolean = false;
  @Output() visibleChange = new EventEmitter<boolean>();
  @Output() confirm = new EventEmitter<any>();

  form: FormGroup;

  fieldOptions = [
    { label: 'Correspondent Ref', value: 'correspondentRef' },
    { label: 'Amount', value: 'amount' },
    { label: 'Date', value: 'date' }
  ];

  constructor(private fb: FormBuilder) {
    this.form = this.fb.group({
      number: [1],
      fields: [[]]
    });
  }

  onCancel() {
    this.visible = false;
    this.visibleChange.emit(false);
  }

  onConfirm() {
    const data = {
      number: this.form.value.number,
      fields: [...new Set(this.form.value.fields)]
    };

    this.confirm.emit(data);
  }
}


